# ==============================================================================
# DevFestVerse - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production on Google Cloud Run, configure these variables under:
#   Cloud Run Service -> Edit & Deploy New Revision -> Variables & Secrets
# ==============================================================================

# --- Google Cloud Platform Settings ---
GCP_PROJECT=gdg-cloud-bangkok-2026
PORT=8000
ENVIRONMENT=development

# --- Application Security & Sessions ---
# Replace with a cryptographically secure random string in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-key-please-change-in-production

# --- Google Identity Services & OAuth 2.0 Client ---
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# --- Cloud Firestore Database Configuration ---
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_EVENTS_COLLECTION=events

# --- Official Community Registration URL ---
DEFAULT_TICKET_REGISTRATION_URL=https://gdg.community.dev/

